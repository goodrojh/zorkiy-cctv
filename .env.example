# URL веб-приложения Google Apps Script (приём заявок: Google-таблица + письмо на info@vidzhio.ru)
# Инструкция по получению — в scripts/apps-script/Code.gs
NEXT_PUBLIC_LEAD_WEBHOOK=https://script.google.com/macros/s/XXXXXXXX/exec

# Номер счётчика Яндекс.Метрики, например 99999999
NEXT_PUBLIC_YM_ID=

# Для деплоя на GitHub Pages (подкаталог репозитория)
GH_REPO=zorkiy-cctv
NEXT_PUBLIC_BASE_PATH=/zorkiy-cctv
